# ============================================================
# NANOfusion Public Web (new-frontend) — Vzorové proměnné prostředí
# ============================================================

# Supabase připojení (veřejné pro čtení publikovaných dat a odesílání poptávek)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Tajný token pro příjem revalidačních požadavků z admin-panelu
REVALIDATION_TOKEN=your-random-revalidation-token


# Service role klíč pro serverové API webu (POVINNÉ):
#  - /api/chat-session ukládá přepisy konverzací s Nanobotem (bez klíče se neukládají)
#  - /api/inquiry ukládá poptávky s rate limitem (bez klíče přes anon klíč, bez limitu)
# NIKDY nepřidávejte prefix NEXT_PUBLIC_ - klíč nesmí do prohlížeče.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Max. počet poptávek z jedné IP adresy za 10 minut (výchozí 5)
INQUIRY_LIMIT_PER_10_MIN=5

# Veřejná adresa webu (canonical, sitemap, Open Graph). Dokud doména
# nanofusion.cz neukazuje na tento web: https://nanofusion.vercel.app
NEXT_PUBLIC_SITE_URL=https://nanofusion.cz
# Adresa administrace (odkaz „Zaměstnanci“ v patičce)
NEXT_PUBLIC_ADMIN_URL=https://nanofusion-j3bs.vercel.app
