{
  "name": "nano-flow-boost-editable",
  "version": "1.0.0",
  "description": "Editable local clone of NANO Conversion Hub",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd new-frontend && npm run dev",
    "dev:admin": "cd admin-panel && npm run dev",
    "dev:legacy": "vite --host --port 5173",
    "build": "npm run build:frontend",
    "build:frontend": "cd new-frontend && npm run build",
    "build:admin": "cd admin-panel && npm run build",
    "build:all": "npm run build:frontend && npm run build:admin",
    "build:legacy": "node sync-content.js && shx mkdir -p dist && shx cp -r public/assets public/static dist/ && shx cp -r index.html o-nas.html faq sluzby dist/ && cd admin-panel && npm install --legacy-peer-deps && npm run build",
    "test": "npm run test:frontend",
    "test:frontend": "cd new-frontend && npm test",
    "test:e2e": "cd new-frontend && npm run test:e2e",
    "preview": "vite preview",
    "format": "prettier --write \"index.html\" \"assets/*.js\" \"assets/*.css\" \"manifest.json\""
  },
  "keywords": [
    "nano",
    "frontend",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3"
  }
}
