{
  "name": "nanofusion",
  "version": "1.0.0",
  "private": true,
  "description": "NANOfusion – veřejný web (new-frontend) a CMS administrace (admin-panel)",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd new-frontend && npm run dev",
    "dev:admin": "cd admin-panel && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd new-frontend && npm run build",
    "build:admin": "cd admin-panel && npm run build",
    "build:all": "npm run build:frontend && npm run build:admin",
    "test": "npm run test:frontend",
    "test:frontend": "cd new-frontend && npm test",
    "test:e2e": "cd new-frontend && npm run test:e2e"
  }
}
